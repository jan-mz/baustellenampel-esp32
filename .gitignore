# Gitignore settings for ESPHome
# ESPHome generierte Dateien, lokale Geheimnisse und Build-Artefakte

# ESPHome Runtime/Project Cache
/.esphome/

# Secret file should not be committed
/secrets.yaml

# PlatformIO build artifacts and caches
/.pio/
/.pioenvs/

# Python and ESPHome caches
__pycache__/
*.py[cod]
*~

# ESPHome generated YAML lock file
/.yaml.lock

# Logs, temporary files and local configuration
*.log
*.tmp
*.bak

# If you use VS Code or other editors
.vscode/
.idea/
.DS_Store
